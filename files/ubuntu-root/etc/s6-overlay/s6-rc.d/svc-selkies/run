#!/usr/bin/with-contenv bash

TARGET_USER="${CUSTOM_USER:-${USER_NAME:-root}}"
PORT="${SELKIES_PORT:-8082}"

# ENCODER is passed from start-container.sh: software|nvidia|nvidia-wsl|intel|amd
ENCODER="${ENCODER:-}"
GPU_VENDOR="${ENCODER:-${GPU_VENDOR:-software}}"

# Check if running in WSL environment
WSL_ENVIRONMENT="${WSL_ENVIRONMENT:-false}"

# Export LIBVA_DRIVER_NAME for Intel/AMD VA-API (set by start-container.sh)
if [ -n "${LIBVA_DRIVER_NAME}" ]; then
  export LIBVA_DRIVER_NAME
  echo "[svc-selkies] Using VA-API driver: ${LIBVA_DRIVER_NAME}"
fi

# WSL2 specific setup for NVIDIA - add WSL libs to paths
if [ "${WSL_ENVIRONMENT}" = "true" ]; then
  echo "[svc-selkies] Running in WSL2 environment"
  if [ -d "/usr/lib/wsl/lib" ]; then
    # Remove /usr/lib/wsl/lib if already present, then add to front
    LD_LIBRARY_PATH="${LD_LIBRARY_PATH//\/usr\/lib\/wsl\/lib:/}"
    LD_LIBRARY_PATH="${LD_LIBRARY_PATH//\/usr\/lib\/wsl\/lib/}"
    export LD_LIBRARY_PATH="/usr/lib/wsl/lib:${LD_LIBRARY_PATH}"
    export PATH="/usr/lib/wsl/lib:${PATH}"
    echo "[svc-selkies] Added WSL library path at front: /usr/lib/wsl/lib"
  fi
fi

# Function to find nvidia-smi (handles WSL2 where it's in /usr/lib/wsl/lib)
find_nvidia_smi() {
  if command -v nvidia-smi &> /dev/null; then
    echo "nvidia-smi"
  elif [ -x "/usr/lib/wsl/lib/nvidia-smi" ]; then
    echo "/usr/lib/wsl/lib/nvidia-smi"
  else
    return 1
  fi
}

# Check if NVIDIA GPU is available (works on both native Linux and WSL2)
nvidia_available() {
  local nvidia_smi_cmd
  nvidia_smi_cmd=$(find_nvidia_smi) || return 1
  "${nvidia_smi_cmd}" >/dev/null 2>&1
}

# Configure pixelflux hardware encoding based on GPU_VENDOR
# pixelflux supports: NVENC (NVIDIA), VA-API (Intel/AMD)
# Setting vaapi_render_node_index >= 0 enables VA-API encoding on /dev/dri/renderD(128 + index)
# -1 means try NVENC if available, otherwise software

# Determine GPU render node index for pixelflux
# PIXELFLUX_VAAPI_RENDER_NODE_INDEX:
#   -1 = Use NVENC (NVIDIA) or software fallback
#   0+ = Use VA-API with /dev/dri/renderD(128+index)
if [ "${GPU_VENDOR}" = "nvidia" ] || [ "${GPU_VENDOR}" = "nvidia-wsl" ]; then
  # NVIDIA: Explicitly disable VA-API to force NVENC
  export PIXELFLUX_VAAPI_RENDER_NODE_INDEX="-1"
  # Find the NVIDIA render node to set CUDA_VISIBLE_DEVICES if needed
  for renderD in /dev/dri/renderD*; do
    if [ -e "$renderD" ]; then
      RENDER_NUM=$(echo "$renderD" | grep -oP 'renderD\K[0-9]+')
      DRIVER_LINK="/sys/class/drm/renderD${RENDER_NUM}/device/driver"
      if [ -L "$DRIVER_LINK" ]; then
        DRIVER_NAME=$(basename "$(readlink -f "$DRIVER_LINK")")
        if [ "$DRIVER_NAME" = "nvidia" ]; then
          echo "[svc-selkies] Found NVIDIA GPU at renderD${RENDER_NUM}"
          break
        fi
      fi
    fi
  done
  echo "[svc-selkies] GPU_VENDOR=${GPU_VENDOR}: pixelflux will use NVENC hardware encoding (VA-API disabled)"
  
  if nvidia_available; then
    NVIDIA_SMI_CMD=$(find_nvidia_smi)
    echo "[svc-selkies] NVIDIA GPU detected via: ${NVIDIA_SMI_CMD}"
  fi
elif [ "${GPU_VENDOR}" = "intel" ] || [ "${GPU_VENDOR}" = "amd" ]; then
  # Intel/AMD: Use VA-API with render node
  # Need to find the correct render node for the specified GPU vendor
  VAAPI_INDEX=""
  
  # Find the correct render node by checking the driver
  for renderD in /dev/dri/renderD*; do
    if [ -e "$renderD" ]; then
      RENDER_NUM=$(echo "$renderD" | grep -oP 'renderD\K[0-9]+')
      DRIVER_LINK="/sys/class/drm/renderD${RENDER_NUM}/device/driver"
      if [ -L "$DRIVER_LINK" ]; then
        DRIVER_NAME=$(basename "$(readlink -f "$DRIVER_LINK")")
        if [ "${GPU_VENDOR}" = "intel" ] && [ "$DRIVER_NAME" = "i915" ]; then
          VAAPI_INDEX=$((RENDER_NUM - 128))
          echo "[svc-selkies] Found Intel GPU at renderD${RENDER_NUM} (driver: ${DRIVER_NAME})"
          break
        elif [ "${GPU_VENDOR}" = "amd" ] && [ "$DRIVER_NAME" = "amdgpu" ]; then
          VAAPI_INDEX=$((RENDER_NUM - 128))
          echo "[svc-selkies] Found AMD GPU at renderD${RENDER_NUM} (driver: ${DRIVER_NAME})"
          break
        fi
      fi
    fi
  done
  
  if [ -n "${VAAPI_INDEX}" ]; then
    export PIXELFLUX_VAAPI_RENDER_NODE_INDEX="${VAAPI_INDEX}"
    echo "[svc-selkies] GPU_VENDOR=${GPU_VENDOR}: pixelflux will use VA-API hardware encoding (index ${VAAPI_INDEX})"
  elif [ -n "${DRI_NODE}" ]; then
    # Fallback to DRI_NODE if set
    RENDER_NUM=$(echo "${DRI_NODE}" | grep -oP 'renderD\K[0-9]+')
    if [ -n "${RENDER_NUM}" ]; then
      VAAPI_INDEX=$((RENDER_NUM - 128))
      export PIXELFLUX_VAAPI_RENDER_NODE_INDEX="${VAAPI_INDEX}"
      echo "[svc-selkies] GPU_VENDOR=${GPU_VENDOR}: pixelflux will use VA-API on ${DRI_NODE} (index ${VAAPI_INDEX})"
    else
      export PIXELFLUX_VAAPI_RENDER_NODE_INDEX="-1"
      echo "[svc-selkies] GPU_VENDOR=${GPU_VENDOR}: Could not determine render node, falling back to software encoding"
    fi
  else
    export PIXELFLUX_VAAPI_RENDER_NODE_INDEX="-1"
    echo "[svc-selkies] GPU_VENDOR=${GPU_VENDOR}: No matching render node found, falling back to software encoding"
  fi
else
  # No GPU or unknown: software encoding
  export PIXELFLUX_VAAPI_RENDER_NODE_INDEX="-1"
  echo "[svc-selkies] GPU_VENDOR=${GPU_VENDOR}: pixelflux will use software encoding"
fi

# Always use selkies with pixelflux (WebSocket mode)
SELKIES_CMD="selkies"
CMD_OPTS=(--addr="localhost" --mode="websockets" --port="${PORT}")
CMD_OPTS+=(--scaling-dpi="${DPI:-96}")

# Disable selkies basic auth - nginx handles authentication
CMD_OPTS+=(--enable-basic-auth=false)

# Disable selkies's own basic auth - nginx (auth-server.py) handles authentication.
# Without this, selkies defaults to enable_basic_auth=True and requires credentials
# that nginx does not pass when proxying, causing WebSocket 401 failures.
CMD_OPTS+=(--enable-basic-auth=false)

# Clean up stale selkies socket files from previous run to prevent EADDRINUSE errors
rm -f /tmp/selkies_js*.sock /tmp/selkies_event*.sock 2>/dev/null || true

# Set web-root so selkies finds its static files without needing the selkies_web
# Python subpackage (which is absent in newer selkies installs / Python 3.14+).
# Prefer /usr/share/selkies/web (runtime copy with nginx patches applied by init-nginx),
# fall back to the original dashboard directory.
if [ -f "/usr/share/selkies/web/index.html" ]; then
  CMD_OPTS+=(--web-root="/usr/share/selkies/web")
elif [ -f "/usr/share/selkies/selkies-dashboard/index.html" ]; then
  CMD_OPTS+=(--web-root="/usr/share/selkies/selkies-dashboard")
fi

# Configure encoder based on GPU vendor
# NOTE: Selkies pixelflux only accepts: x264enc, x264enc-striped, jpeg
# Hardware encoding (NVENC/VA-API) is controlled via:
#   - --use-cpu=false (default): pixelflux auto-detects GPU and uses hardware encoding
#   - --use-cpu=true: force software encoding
#   - For VA-API, set PIXELFLUX_VAAPI_RENDER_NODE_INDEX env var (already done above)
ENCODER_TYPE="x264enc"

if [ "${GPU_VENDOR}" = "nvidia" ] || [ "${GPU_VENDOR}" = "nvidia-wsl" ]; then
  # NVIDIA: pixelflux auto-detects NVENC when --use-cpu=false (default)
  CMD_OPTS+=(--encoder="${ENCODER_TYPE}")
  CMD_OPTS+=(--use-cpu=false)
  echo "[svc-selkies] Using NVIDIA NVENC hardware encoding (pixelflux auto-detect)"
elif [ "${GPU_VENDOR}" = "intel" ] || [ "${GPU_VENDOR}" = "amd" ]; then
  # Intel/AMD: pixelflux uses VA-API via PIXELFLUX_VAAPI_RENDER_NODE_INDEX env var
  CMD_OPTS+=(--encoder="${ENCODER_TYPE}")
  CMD_OPTS+=(--use-cpu=false)
  
  if [ -n "${VAAPI_INDEX}" ]; then
    DRI_NODE_PATH="/dev/dri/renderD$((128 + VAAPI_INDEX))"
    if [ -e "${DRI_NODE_PATH}" ]; then
      CMD_OPTS+=(--dri-node="${DRI_NODE_PATH}")
      echo "[svc-selkies] Added --dri-node=${DRI_NODE_PATH} for VA-API encoding"
    fi
  fi
  echo "[svc-selkies] Using VA-API hardware encoding (pixelflux via PIXELFLUX_VAAPI_RENDER_NODE_INDEX=${PIXELFLUX_VAAPI_RENDER_NODE_INDEX})"
else
  # Software encoder (x264enc) - force CPU encoding
  CMD_OPTS+=(--encoder="${ENCODER_TYPE}")
  CMD_OPTS+=(--use-cpu=true)
  echo "[svc-selkies] Using software encoding (CPU only)"
fi

# Enable H.264 streaming mode for lower latency (crucial for responsiveness!)
# This enables low-latency encoding with reduced buffering
CMD_OPTS+=(--h264-streaming-mode=true)
echo "[svc-selkies] H.264 streaming mode enabled for low latency"

# Framerate configuration
# SELKIES_FRAMERATE can be:
#   - A single value (e.g., "60") for fixed framerate
#   - A range (e.g., "30-60") to allow client-side selection within range
# Lower values improve stability and reduce latency
# Recommended: "30" for low latency, "30-60" for balanced performance
SELKIES_FRAMERATE="${SELKIES_FRAMERATE:-30}"
CMD_OPTS+=(--framerate="${SELKIES_FRAMERATE}")
echo "[svc-selkies] Framerate set to: ${SELKIES_FRAMERATE}"

# CRF (Constant Rate Factor) for H.264 encoding
# Lower = better quality but larger file size and more latency
# Higher = lower quality but faster encoding and less latency
# Range: 0-51, Recommended: 23-28 for low latency, 18-22 for quality
# Default: 25 for balanced latency/quality
SELKIES_H264_CRF="${SELKIES_H264_CRF:-25}"
CMD_OPTS+=(--h264-crf="${SELKIES_H264_CRF}")
echo "[svc-selkies] H.264 CRF set to: ${SELKIES_H264_CRF}"

# Paint-over CRF for static scenes (higher quality when not moving)
SELKIES_H264_PAINTOVER_CRF="${SELKIES_H264_PAINTOVER_CRF:-20}"
CMD_OPTS+=(--h264-paintover-crf="${SELKIES_H264_PAINTOVER_CRF}")
echo "[svc-selkies] H.264 Paint-over CRF set to: ${SELKIES_H264_PAINTOVER_CRF}"

# Audio configuration: explicitly enable audio and point to the null-sink device
# SELKIES_AUDIO_DEVICE: PulseAudio sink name to capture (default: "output")
SELKIES_AUDIO_DEVICE="${SELKIES_AUDIO_DEVICE:-output}"
CMD_OPTS+=(--audio-enabled=true)
CMD_OPTS+=(--audio-device-name="${SELKIES_AUDIO_DEVICE}")
echo "[svc-selkies] Audio enabled, device: ${SELKIES_AUDIO_DEVICE}"

# Disable binary (image) clipboard: wl-paste --list-types blocks indefinitely on
# wayland-0 (KWin) when the clipboard is empty, causing the process to appear as
# a Wayland app in the KDE taskbar.  Text clipboard works via Klipper D-Bus.
CMD_OPTS+=(--enable-binary-clipboard=false)
echo "[svc-selkies] Binary clipboard disabled (text clipboard via Klipper D-Bus)"

echo "[svc-selkies] Using selkies with pixelflux (GPU_VENDOR=${GPU_VENDOR}, use-cpu=${USE_CPU:-false})"

# Resolve the correct PulseAudio/PipeWire-pulse socket for this user.
# PULSE_RUNTIME_PATH from the s6 container environment may be /defaults (legacy
# Ubuntu 22.04/24.04 path); on Ubuntu 26.04+ PipeWire-pulse puts the socket at
# $XDG_RUNTIME_DIR/pulse/native. Override PULSE_SERVER unconditionally so pactl
# finds the real socket regardless of what with-contenv injects.
TARGET_UID_SEL="$(id -u "${TARGET_USER}" 2>/dev/null || echo 1000)"
PULSE_SOCKET_PATH="/run/user/${TARGET_UID_SEL}/pulse/native"
export PULSE_SERVER="unix:${PULSE_SOCKET_PATH}"
unset PULSE_RUNTIME_PATH

pactl_cmd() {
  # Wrapper that always points to the correct PipeWire-pulse socket,
  # bypassing any PULSE_RUNTIME_PATH injected by with-contenv.
  s6-setuidgid "$TARGET_USER" env \
    PULSE_SERVER="unix:${PULSE_SOCKET_PATH}" \
    XDG_RUNTIME_DIR="/run/user/${TARGET_UID_SEL}" \
    PULSE_RUNTIME_PATH="" \
    pactl "$@"
}

pulse_has_sink() {
  local sink_name="$1"
  pactl_cmd list short sinks 2>/dev/null | awk '{print $2}' | grep -qx "${sink_name}"
}

pulse_has_source() {
  local source_name="$1"
  pactl_cmd list short sources 2>/dev/null | awk '{print $2}' | grep -qx "${source_name}"
}

# Default sink setup (wait until pulseaudio is ready, then create virtual sinks)
if [ ! -f '/dev/shm/audio.lock' ] || ! pulse_has_sink output || ! pulse_has_sink input || ! pulse_has_source output.monitor; then
  rm -f /dev/shm/audio.lock
  # ensure pulseaudio is up
  for i in $(seq 1 30); do
    if pactl_cmd info >/dev/null 2>&1; then
      READY=1
      break
    fi
    sleep 0.5
  done
  if [ "${READY:-0}" -eq 1 ]; then
    if ! pulse_has_sink output; then
      pactl_cmd \
        load-module module-null-sink \
        sink_name="output" \
        sink_properties=device.description="output" >/dev/null
    fi
    if ! pulse_has_sink input; then
      pactl_cmd \
        load-module module-null-sink \
        sink_name="input" \
        sink_properties=device.description="input" >/dev/null
    fi
    pactl_cmd set-default-sink output >/dev/null 2>&1 || true
    pactl_cmd set-default-source output.monitor >/dev/null 2>&1 || true
    if pulse_has_sink output && pulse_has_sink input && pulse_has_source output.monitor; then
      touch /dev/shm/audio.lock
    else
      echo "[svc-selkies] pulseaudio recovered, but virtual sinks are incomplete (audio may still be missing)." >&2
    fi
  else
    echo "[svc-selkies] pulseaudio not ready; skipped null-sink setup (audio may be missing)." >&2
  fi
fi

# Setup dev mode if defined
if [ ! -z ${DEV_MODE+x} ]; then
  # Dev deps
  apt-get update
  apt-get install -y \
    nodejs
  npm install -g nodemon
  rm -Rf $HOME/.npm
  # Frontend setup
  if [[ "${DEV_MODE}" == "core" ]]; then
    # Core just runs from directory
    cd $HOME/src/addons/selkies-web-core
    s6-setuidgid "$TARGET_USER" npm install
    s6-setuidgid "$TARGET_USER" npm run serve &
  else
    # Build core
    cd $HOME/src/addons/selkies-web-core
    s6-setuidgid "$TARGET_USER" npm install
    s6-setuidgid "$TARGET_USER" npm run build
    s6-setuidgid "$TARGET_USER" cp dist/selkies-core.js ../${DEV_MODE}/src/
    s6-setuidgid "$TARGET_USER" nodemon --watch selkies-core.js --exec "npm run build && cp dist/selkies-core.js ../${DEV_MODE}/src/" & 
    # Copy touch gamepad
    s6-setuidgid "$TARGET_USER" cp ../universal-touch-gamepad/universalTouchGamepad.js ../${DEV_MODE}/src/
    s6-setuidgid "$TARGET_USER" nodemon --watch ../universal-touch-gamepad/universalTouchGamepad.js --exec "cp ../universal-touch-gamepad/universalTouchGamepad.js ../${DEV_MODE}/src/" &  
    # Copy themes
    s6-setuidgid "$TARGET_USER" cp -a nginx ../${DEV_MODE}/
    # Run passed frontend
    cd $HOME/src/addons/${DEV_MODE}
    s6-setuidgid "$TARGET_USER" npm install
    s6-setuidgid "$TARGET_USER" npm run serve &
  fi
  # Run backend
  cd $HOME/src/src
  s6-setuidgid "$TARGET_USER" \
    nodemon -V --ext py --exec \
      "python3" -m selkies \
      --addr="localhost" \
      --mode="websockets" \
      --debug="true"
fi

# Start Selkies
echo "[svc-selkies] Starting ${SELKIES_CMD} on port ${PORT}"
exec s6-setuidgid "$TARGET_USER" "${SELKIES_CMD}" "${CMD_OPTS[@]}"
